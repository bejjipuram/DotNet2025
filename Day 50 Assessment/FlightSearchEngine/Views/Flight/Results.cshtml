@model IEnumerable<object>
@using FlightSearchEngine.Models

@{
    ViewData["Title"] = "Results";
}

<h2>Search Results</h2>

@if (Model == null || !Model.Any())
{
    <div>No results found.</div>
}
else
{
    var first = Model.First();
    if (first is FlightResult)
    {
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>FlightId</th>
                    <th>FlightName</th>
                    <th>FlightType</th>
                    <th>Source</th>
                    <th>Destination</th>
                    <th>TotalCost</th>
                </tr>
            </thead>
            <tbody>
                @foreach (FlightResult item in Model)
                {
                    <tr>
                        <td>@item.FlightId</td>
                        <td>@item.FlightName</td>
                        <td>@item.FlightType</td>
                        <td>@item.Source</td>
                        <td>@item.Destination</td>
                        <td>@item.TotalCost.ToString("C")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else if (first is FlightHotelResult)
    {
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>FlightId</th>
                    <th>FlightName</th>
                    <th>Source</th>
                    <th>Destination</th>
                    <th>HotelName</th>
                    <th>TotalCost</th>
                </tr>
            </thead>
            <tbody>
                @foreach (FlightHotelResult item in Model)
                {
                    <tr>
                        <td>@item.FlightId</td>
                        <td>@item.FlightName</td>
                        <td>@item.Source</td>
                        <td>@item.Destination</td>
                        <td>@item.HotelName</td>
                        <td>@item.TotalCost.ToString("C")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div>Unknown result type.</div>
    }
}

<a asp-action="Index" asp-controller="Flight" class="btn btn-secondary">Back to Search</a>