@model IEnumerable<FlightSearchEngine.Models.FlightResult>

@{
    ViewData["Title"] = "Flight Results";
}

<h2>Flight Results</h2>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">No flights found for the selected route.</div>
}
else
{
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>FlightId</th>
                <th></th>
                <th>FlightName</th>
                <th>FlightType</th>
                <th>Source</th>
                <th>Destination</th>
                <th class="text-end">TotalCost</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><a asp-action="FlightDetails" asp-route-id="@item.FlightId" class="btn btn-sm btn-primary">Details</a></td>
                    <td>@item.FlightId</td>
                    <td>@item.FlightName</td>
                    <td>@item.FlightType</td>
                    <td>@item.Source</td>
                    <td>@item.Destination</td>
                    <td class="text-end">@item.TotalCost.ToString("C")</td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="mt-3">
    <a asp-controller="Flight" asp-action="Index" class="btn btn-secondary">Back to Search</a>
    <a asp-controller="Flight" asp-action="Index" class="btn btn-warning" style="margin-left:8px;">Search Flight + Hotel</a>
</div>