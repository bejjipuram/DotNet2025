@model FlightSearchEngine.Models.SearchViewModel

@{
    ViewData["Title"] = "Search Flights";
}

<h2>Search Flights</h2>

@* Show server-side model errors captured in controller when ModelState is invalid *@
@if (ViewBag.ModelErrors != null)
{
    var list = ViewBag.ModelErrors as List<string>;
    if (list != null && list.Any())
    {
        <div class="alert alert-danger">
            <strong>Validation errors:</strong>
            <ul>
                @foreach (var err in list)
                {
                    <li>@err</li>
                }
            </ul>
        </div>
    }
}

<form asp-controller="Flight" asp-action="SearchFlights" method="post" id="searchForm">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div>
        <label>Source</label>
        @Html.DropDownListFor(m => m.Source, Model.SourceList, "-- Select Source --", new { @class = "form-control" })
        <span asp-validation-for="Source" class="text-danger"></span>
    </div>
    <div>
        <label>Destination</label>
        @Html.DropDownListFor(m => m.Destination, Model.DestinationList, "-- Select Destination --", new { @class = "form-control" })
        <span asp-validation-for="Destination" class="text-danger"></span>
    </div>
    <div>
        <label>Number Of Persons</label>
        <input asp-for="NumberOfPersons" type="number" min="1" max="10" class="form-control" />
        <span asp-validation-for="NumberOfPersons" class="text-danger"></span>
    </div>
    @Html.AntiForgeryToken()
    <div style="margin-top:10px">
        <button type="submit" class="btn btn-success" formaction="@Url.Action("SearchFlights", "Flight")" id="btnFlights">Search Flights Only</button>
        <button type="submit" class="btn btn-warning" formaction="@Url.Action("SearchFlightsWithHotels", "Flight")" id="btnPackage">Search Flight + Hotel</button>
    </div>
</form>

@section Scripts {
    @* Include unobtrusive validation scripts if layout supports RenderSection("Scripts") *@
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        (function() {
            var form = document.getElementById('searchForm');
            if (!form) return;
            form.addEventListener('submit', function(e) {
                var srcEl = document.querySelector('[name="Source"]');
                var destEl = document.querySelector('[name="Destination"]');
                var src = srcEl ? srcEl.value : '';
                var dest = destEl ? destEl.value : '';
                if (src && src === dest) {
                    e.preventDefault();
                    alert('Source and destination cannot be the same.');
                    return false;
                }
                // show simple loading state
                var btn = document.activeElement;
                if (btn && btn.tagName === 'BUTTON') {
                    btn.disabled = true;
                    btn.innerText = 'Searching...';
                }
            });
        })();
    </script>
}
