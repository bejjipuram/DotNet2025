@model IEnumerable<DraftApp.Models.Enrollment>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Student.FullName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PaymentStatus)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PaidAmount)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EnrollDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Course.Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Student)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Student.FullName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PaymentStatus)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PaidAmount)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EnrollDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Course.Title)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Student.Status)
            </td>
            <td>
                    <a asp-action="Edit" asp-route-id="@item.EnrollmentId" class="btn btn-sm btn-outline-primary btn-info" style="color:black">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.EnrollmentId" class="btn btn-sm btn-outline-primary" style="color:black">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.EnrollmentId" class="btn btn-sm btn-outline-primary btn-danger" style="color:black">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
