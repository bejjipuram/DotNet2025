@model WebAppHttpClientDemo.Models.Product

<h2>Create Product</h2>

<form asp-action="Create" method="post">

    <div>
        <label>Title</label>
        <input asp-for="Title" />
    </div>

    <div>
        <label>Description</label>
        <input asp-for="Description" />
    </div>

    <div>
        <label>Category</label>
        <input asp-for="Category" />
    </div>

    <div>
        <label>Price</label>
        <input asp-for="Price" />
    </div>

    <div>
        <label>Stock</label>
        <input asp-for="Stock" />
    </div>

    <div>
        <label>Brand</label>
        <input asp-for="Brand" />
    </div>

    <div>
        <label>Thumbnail URL</label>
        <input asp-for="Thumbnail" />
    </div>

    <br>

    <button type="submit">Create Product</button>

</form>